{
  "name": "open-dynamic-workflows",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "A faithful, standalone reimplementation of the official Claude Code Workflow tool's orchestration runtime. Runs a JS workflow script that fans out subagents via agent()/parallel()/pipeline()/phase(). Pluggable per-node executors for Gemini CLI, Claude Code and Codex; Windows-ready. almo-intellect fork of imsai-sh/open-dynamic-workflows.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/almo-intellect/open-dynamic-workflows.git"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "odw": "./dist/cli.js",
    "open-dynamic-workflows": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "smoke": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.3"
  }
}
